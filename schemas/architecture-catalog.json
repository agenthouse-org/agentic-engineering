{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "entries"],
  "properties": {
    "schemaVersion": {"enum": [1]},
    "kind": {"const": "architecture-catalog"},
    "ownerRole": {"type": "string", "minLength": 1},
    "standardRef": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "authorityClass"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "accepted", "deprecated", "superseded"]},
          "authorityClass": {"enum": ["mandatory", "default", "advisory"]},
          "scope": {"enum": ["organization", "team", "project", "component"]},
          "ruleIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supersedes": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
