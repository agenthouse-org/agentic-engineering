{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "criteria"],
  "properties": {
    "schemaVersion": {"enum": [1]}, "id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["kind", "reference", "revision"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["image", "story", "bug", "wireframe"]}, "reference": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "fidelity": {"enum": ["wireframe", "design", "prototype"]}}},
    "references": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "expectation", "method"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "expectation": {"type": "string", "minLength": 1},
        "method": {"enum": ["concept", "regression", "behavior", "accessibility"]}, "required": {"type": "boolean"},
        "viewport": {"type": "string"}, "state": {"type": "string"}}
    }}
  }
}
