{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "rules"],
  "properties": {
    "schemaVersion": {"enum": [1]}, "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string"}, "owner": {"type": "string", "minLength": 1},
    "authorities": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "requiredChecks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "mode", "value"],
      "properties": {"id": {"type": "string", "minLength": 1}, "mode": {"enum": ["mandatory", "default", "advisory"]}, "value": {}, "decision": {"type": "string"}, "description": {"type": "string"}}
    }}
  }
}
