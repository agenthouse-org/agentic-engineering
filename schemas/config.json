{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "project", "evaluators", "profiles"],
  "properties": {
    "schemaVersion": {"enum": [1]}, "project": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
    "autonomy": {"enum": ["supervised", "bounded", "delegated"]},
    "documentationAuthority": {"type": "string", "minLength": 1},
    "policySources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "overrides": {"type": "object"},
    "evaluators": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
        "kind": {"enum": ["command", "evidence", "approval", "visual", "work-item"]},
        "executable": {"type": "string", "minLength": 1}, "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"}, "timeoutSeconds": {"type": "number", "minimum": 0.05, "maximum": 86400},
        "result": {"enum": ["exit-code", "json"]},
        "exitCodes": {"type": "object", "additionalProperties": {"enum": ["passed", "failed", "error", "incomplete", "pending"]}},
        "requiredEnvironment": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "file": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1}, "assessment": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1}
      }
    }},
    "profiles": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["checks"], "additionalProperties": false,
      "properties": {"checks": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["evaluator"], "additionalProperties": false,
        "properties": {"evaluator": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "allowNotApplicable": {"type": "boolean"}}
      }}}
    }}
  }
}
