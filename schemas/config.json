{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "evaluators",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
    },
    "autonomy": {
      "enum": [
        "supervised",
        "bounded",
        "delegated"
      ]
    },
    "documentationAuthority": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchNaming": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "example": {
              "type": "string",
              "minLength": 1
            },
            "baseDefault": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "unit",
              "component",
              "integration",
              "functional-api",
              "end-to-end",
              "regression",
              "contract"
            ]
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "unit",
              "component",
              "integration",
              "functional-api",
              "end-to-end",
              "regression",
              "contract"
            ]
          }
        }
      }
    },
    "policySources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overrides": {
      "type": "object"
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
          },
          "kind": {
            "enum": [
              "command",
              "evidence",
              "approval",
              "visual",
              "work-item"
            ]
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 86400
          },
          "result": {
            "enum": [
              "exit-code",
              "json"
            ]
          },
          "exitCodes": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "passed",
                "failed",
                "error",
                "incomplete",
                "pending"
              ]
            }
          },
          "requiredEnvironment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "specificationFiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "promotion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reference",
              "owner"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reached",
                  "deferred"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "recordedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "evaluator"
              ],
              "additionalProperties": false,
              "properties": {
                "evaluator": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "allowNotApplicable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approval": {
              "type": "boolean"
            },
            "independent": {
              "type": "boolean"
            },
            "allowNotApplicable": {
              "type": "boolean"
            },
            "requireRed": {
              "type": "boolean"
            },
            "requireGreen": {
              "type": "boolean"
            },
            "ticketSize": {
              "type": "boolean"
            },
            "maxCriteria": {
              "type": "integer",
              "minimum": 1
            },
            "kindFields": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "done": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approval": {
              "type": "boolean"
            },
            "independent": {
              "type": "boolean"
            },
            "allowNotApplicable": {
              "type": "boolean"
            },
            "requireRed": {
              "type": "boolean"
            },
            "requireGreen": {
              "type": "boolean"
            },
            "kindFields": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          }
        },
        "pathKinds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockNoVerify": {
          "type": "boolean"
        },
        "protectedBranches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "executable",
              "args",
              "extensions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\."
                }
              },
              "available": {
                "type": "string"
              },
              "timeoutSeconds": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 300
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
