{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "title", "segments"],
  "properties": {
    "schemaVersion": {"enum": [1]},
    "kind": {"enum": ["market-opportunity"]},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
    "title": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "firmographics", "buyer", "user", "decisionMaker", "job", "pain", "valueHypothesis", "willingnessToPay", "channels", "basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
          "description": {"type": "string", "minLength": 1},
          "firmographics": {"type": "string", "minLength": 1},
          "buyer": {"type": "string", "minLength": 1},
          "user": {"type": "string", "minLength": 1},
          "decisionMaker": {"type": "string", "minLength": 1},
          "job": {"type": "string", "minLength": 1},
          "pain": {"type": "string", "minLength": 1},
          "valueHypothesis": {"type": "string", "minLength": 1},
          "willingnessToPay": {"type": "string", "minLength": 1},
          "channels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "basis": {"enum": ["evidence", "assumption", "unresolved"]}
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "statedAt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
          "kind": {"enum": ["success", "stop"]},
          "segment": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "statedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
