{
  "name": "@agenthouse/engineering",
  "version": "1.0.0",
  "description": "Portable agentic SDLC, policy and evidence evaluation for developers and CI/CD",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ah-engineering": "bin/ah-engineering.js"
  },
  "exports": {
    ".": "./src/evaluate.js",
    "./playwright": "./adapters/playwright.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "skills",
    "modules",
    "templates",
    "adapters",
    "docs",
    "README.md",
    "LICENSE",
    "dependencies",
    ".codex-plugin",
    ".claude-plugin",
    ".agents/plugins/marketplace.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/build-agent-skills.mjs --check && node scripts/check-release.mjs",
    "prepack": "npm run check",
    "test:browser": "node scripts/test-browser.mjs",
    "build:agent-skills": "node scripts/build-agent-skills.mjs",
    "test:usability": "node scripts/test-usability.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthouse-org/agentic-engineering.git"
  },
  "homepage": "https://github.com/agenthouse-org/agentic-engineering#readme",
  "bugs": {
    "url": "https://github.com/agenthouse-org/agentic-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "agenthouse": {
    "release": {
      "schemaVersion": 1,
      "channel": "stable",
      "compatibleFrom": "0.1.0"
    }
  }
}
